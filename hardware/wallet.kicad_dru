(version 1)
# JLCPCB PCB manufacturing limits, multilayer (4-layer), 1 oz outer / 0.5 oz inner copper.
# Source: https://jlcpcb.com/capabilities/pcb-capabilities  (read 2026-11-01; the page has
# no "last updated" date). Re-check the page before each order: JLCPCB changes it.
#
# Board-wide minimums (Board Setup > Constraints, in wallet.kicad_pro) carry the page's
# single numbers: track/spacing 0.09, copper to routed edge 0.2, via hole to hole 0.2,
# hole to track 0.2, min drill 0.15, via 0.15 hole / 0.25 pad, silkscreen line 0.15 and
# text 1.0 mm, pad to silkscreen 0.15. Solder mask is 1:1 (pad_to_mask_clearance 0).
# The rules below are the page's per-object-type limits KiCad has no board-wide setting for.

(rule "JLC via pad >= hole + 0.1 mm (0.05 mm ring)"
    (condition "A.Type == 'Via'")
    (constraint annular_width (min 0.05mm)))

(rule "JLC PTH annular ring >= 0.15 mm (0.20 recommended)"
    (condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'")
    (constraint annular_width (min 0.15mm)))

# PTH hole to PTH hole >= 0.45 mm and via hole to hole >= 0.2 mm: KiCad 10's hole-to-hole check
# does not fire in this project (not even at 3 mm), so tools/check_jlc.py measures them.

(rule "JLC PTH hole to track >= 0.28 mm (0.35 recommended)"
    (condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole' && B.Type == 'Track'")
    (constraint hole_clearance (min 0.28mm)))

(rule "JLC SMD pad to SMD pad, different nets >= 0.15 mm"
    (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.Pad_Type == 'SMD' && B.Pad_Type == 'SMD'")
    (constraint clearance (min 0.15mm)))

(rule "JLC pad to track >= 0.1 mm"
    (condition "A.Type == 'Pad' && B.Type == 'Track'")
    (constraint clearance (min 0.1mm)))

(rule "JLC non-plated hole >= 0.5 mm"
    (condition "A.Type == 'Pad' && A.Pad_Type == 'NPTH, mechanical'")
    (constraint hole_size (min 0.5mm)))

(rule "JLC inner layer: via hole to copper >= 0.2 mm"
    (layer inner)
    (condition "A.Type == 'Via'")
    (constraint hole_clearance (min 0.2mm)))

(rule "JLC inner layer: PTH pad hole to copper >= 0.3 mm"
    (layer inner)
    (condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'")
    (constraint hole_clearance (min 0.3mm)))
