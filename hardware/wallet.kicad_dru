(version 1)
# JLCPCB 4-layer standard process, matching jlcpcb-4L.edru (the rules used in Fusion).
# Board-wide minimums (Board Setup > Constraints) are already at or stricter than JLCPCB:
#   track 0.127 (JLC 0.09), clearance 0.127 (0.09), copper-edge 0.3 (0.2),
#   hole-hole 0.25 (0.2), drill 0.2 (0.15), via ring 0.15 (0.15).
# These add the JLCPCB rules KiCad has no board-wide setting for.

(rule "JLC PTH pad annular ring >= 0.18 mm"
    (condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'")
    (constraint annular_width (min 0.18mm)))

(rule "JLC via annular ring >= 0.15 mm"
    (condition "A.Type == 'Via'")
    (constraint annular_width (min 0.15mm)))

(rule "JLC PTH pad to PTH pad >= 0.15 mm"
    (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.Pad_Type == 'Through-hole' && B.Pad_Type == 'Through-hole'")
    (constraint clearance (min 0.15mm)))

(rule "JLC inner layer: via hole to copper >= 0.2 mm"
    (layer inner)
    (condition "A.Type == 'Via'")
    (constraint hole_clearance (min 0.2mm)))

(rule "JLC inner layer: PTH pad hole to copper >= 0.3 mm"
    (layer inner)
    (condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'")
    (constraint hole_clearance (min 0.3mm)))
